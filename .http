### ------------------------------------------------------------------
### SIMULAR UNA ALERTA (Notificaciones)
### Importante: Dado que el endpoint cuenta con validación de seguridad
### (getCurrentUser()), es posible que esta petición arroje 401 (Unauthorized)
### si no le pasas tu Cookie o Token de sesión actual.
### Para que funcione 100%, puedes copiar el valor de "Cookie" de cualquier 
### request exitoso usando las herramientas de desarrollador (F12) en Chrome
### y pegarlo debajo de Content-Type.
### ------------------------------------------------------------------

POST http://localhost:3000/api/notificaciones
Content-Type: application/json
Cookie: sb-axuadjuavytmxvgfqzyj-auth-token.0=base64-; sb-axuadjuavytmxvgfqzyj-auth-token.1=jI2LjU4MzMzWiIsImlzX2Fub255bW91cyI6ZmFsc2V9LCJ3ZWFrX3Bhc3N3b3JkIjpudWxsfQ

{
  "Tipo": "WARNING",
  "Titulo": "Stock Crítico Mínimo",
  "Mensaje": "El artículo 'Coca-Cola 2.25L' está por agotarse. Quedan 2 unidades.",
  "EntidadTipo": "ARTICULO_STOCK",
  "EntidadId": "123",
  "AccionUrl": "/productos"
}

###

### ------------------------------------------------------------------
### LISTAR NOTIFICACIONES
### ------------------------------------------------------------------

GET http://localhost:3000/api/notificaciones?limit=10
# Cookie: pegar_tu_cookie_aqui_para_autorizacion

