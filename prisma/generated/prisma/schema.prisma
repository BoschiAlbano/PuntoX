generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model MigrationHistory {
  MigrationId    String @db.NVarChar(150)
  ContextKey     String @db.NVarChar(300)
  Model          Bytes
  ProductVersion String @db.NVarChar(32)

  @@id([MigrationId, ContextKey], map: "PK_dbo.__MigrationHistory")
  @@map("__MigrationHistory")
}

model Articulo {
  Id                   BigInt               @id(map: "PK_dbo.Articulo") @default(autoincrement())
  MarcaId              BigInt
  RubroId              BigInt
  UnidadMedidaId       BigInt
  IvaId                BigInt
  PrecioId             BigInt
  Codigo               Int
  CodigoBarra          String               @db.VarChar(100)
  Abreviatura          String?              @db.VarChar(20)
  Descripcion          String               @db.VarChar(250)
  Detalle              String?              @db.VarChar(500)
  Ubicacion            String?              @db.VarChar(500)
  PrecioCosto          Decimal              @db.Decimal(18, 2)
  PorcentajeGanancia   Decimal              @db.Decimal(18, 2)
  Foto                 Bytes
  ActivarLimiteVenta   Boolean
  LimiteVenta          Decimal              @db.Decimal(18, 2)
  ActivarHoraVenta     Boolean
  HoraLimiteVentaDesde DateTime             @db.DateTime
  HoraLimiteVentaHasta DateTime             @db.DateTime
  PermiteStockNegativo Boolean
  DescuentaStock       Boolean
  StockMinimo          Decimal              @db.Decimal(18, 2)
  VencimientoDias      Int
  TipoVenta            Int
  EstaEliminado        Boolean
  Iva                  Iva                  @relation(fields: [IvaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Iva_IvaId")
  Marca                Marca                @relation(fields: [MarcaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Marca_MarcaId")
  Precio               Precio               @relation(fields: [PrecioId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Precio_PrecioId")
  Rubro                Rubro                @relation(fields: [RubroId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Rubro_RubroId")
  UnidadMedida         UnidadMedida         @relation(fields: [UnidadMedidaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.UnidadMedida_UnidadMedidaId")
  BajaArticulo         BajaArticulo[]
  DetalleComprobante   DetalleComprobante[]
  Stock                Stock[]

  @@index([IvaId], map: "IX_IvaId")
  @@index([MarcaId], map: "IX_MarcaId")
  @@index([PrecioId], map: "IX_PrecioId")
  @@index([RubroId], map: "IX_RubroId")
  @@index([UnidadMedidaId], map: "IX_UnidadMedidaId")
}

model BajaArticulo {
  Id            BigInt      @id(map: "PK_dbo.BajaArticulo") @default(autoincrement())
