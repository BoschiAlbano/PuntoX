generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Historial de migraciones (heredado de otro sistema / EF). No se usa para lógica de negocio.
model MigrationHistory {
  MigrationId    String @db.NVarChar(150)
  ContextKey     String @db.NVarChar(300)
  Model          Bytes
  ProductVersion String @db.NVarChar(32)

  @@id([MigrationId, ContextKey], map: "PK_dbo.__MigrationHistory")
  @@map("__MigrationHistory")
}

/// Representa un comercio/cliente del SaaS. Todo lo que tiene TenantId pertenece a este Tenant.
model Tenant {
  Id                  BigInt               @id @default(autoincrement())
  Nombre              String               @db.VarChar(250)
  /// Dominio o subdominio asignado a este tenant (opcional)
  Dominio             String?              @unique(map: "UX_Tenant_Dominio") @db.VarChar(400)
  RazonSocial         String?              @db.VarChar(250)
  Cuit                String?              @db.VarChar(20)
  Email               String?              @db.VarChar(250)
  Telefono            String?              @db.VarChar(25)
  EstaActivo          Boolean              @default(true)
  /// Plan comercial asociado (nullable para compatibilidad)
  PlanId              BigInt?
  Articulos           Articulo[]
  BajaArticulos       BajaArticulo[]
  Bancos              Banco[]
  Cajas               Caja[]
  Cheques             Cheque[]
  Comprobantes        Comprobante[]
  ConceptosGasto      ConceptoGastos[]
  Configuraciones     Configuracion[]
  Contadores          Contador[]
  CuentasBancarias    CuentaBancarias[]
  Depositos           Deposito[]
  DepositosCheques    DepositoCheques[]
  DetallesCaja        DetalleCaja[]
  DetallesComprobante DetalleComprobante[]
  FormasPago          FormaPago[]
  FormulariosPerfiles FormularioPerfil[]
  FormulariosPermisos Formularios[]
  Gastos              Gasto[]
  Logs                Log[]
  Marcas              Marca[]
  MotivosBaja         MotivoBajas[]
  Movimientos         Movimiento[]
  Perfiles            Perfiles[]
  PerfilesUsuarios    PerfilUsuario[]
  Personas            Persona[]
  Precios             Precio[]
  Proveedores         Proveedor[]
  PuestosTrabajo      PuestoTrabajo[]
  Rubros              Rubro[]
  Stocks              Stock[]
  Tarjetas            Tarjeta[]
  Plan                PlanSaaS?            @relation(fields: [PlanId], references: [Id])
  Unidades            UnidadMedida[]
  Usuarios            Usuario[]

  @@index([PlanId], map: "IX_Tenant_PlanId")
}

/// Planes de suscripciカn SaaS disponibles (global)
model PlanSaaS {
  Id              BigInt   @id @default(autoincrement())
  Nombre          String   @unique(map: "UX_PlanSaaS_Nombre") @db.VarChar(200)
  Descripcion     String?  @db.VarChar(800)
  CostoMensual    Decimal  @db.Decimal(18, 2)
  /// Caracteristicas adicionales (texto/JSON serializado)
  Caracteristicas String?  @db.VarChar(4000)
  Tenants         Tenant[]
}

/// Logs de aplicaciカn; TenantId nullable permite logs globales o por tenant
model Log {
  Id       BigInt   @id @default(autoincrement())
  TenantId BigInt?
  Fecha    DateTime @default(now()) @db.DateTime
  Nivel    String   @db.VarChar(50)
  Servicio String?  @db.VarChar(200)
  Mensaje  String   @db.VarChar(4000)
  Metadata String?  @db.VarChar(4000)
  Tenant   Tenant?  @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([Fecha])
}

/// Artículos/Productos del comercio. Incluye datos de stock y atributos comerciales.
model Articulo {
  Id                   BigInt               @id(map: "PK_dbo.Articulo") @default(autoincrement())
  MarcaId              BigInt
  RubroId              BigInt
  UnidadMedidaId       BigInt
  IvaId                BigInt
  PrecioId             BigInt
  Codigo               Int
  CodigoBarra          String               @db.VarChar(100)
  Abreviatura          String?              @db.VarChar(20)
  Descripcion          String               @db.VarChar(250)
  Detalle              String?              @db.VarChar(500)
  Ubicacion            String?              @db.VarChar(500)
  PrecioCosto          Decimal              @db.Decimal(18, 2)
  PorcentajeGanancia   Decimal              @db.Decimal(18, 2)
  Foto                 Bytes
  ActivarLimiteVenta   Boolean
  LimiteVenta          Decimal              @db.Decimal(18, 2)
  ActivarHoraVenta     Boolean
  HoraLimiteVentaDesde DateTime             @db.DateTime
  HoraLimiteVentaHasta DateTime             @db.DateTime
  PermiteStockNegativo Boolean
  DescuentaStock       Boolean
  StockMinimo          Decimal              @db.Decimal(18, 2)
  VencimientoDias      Int
  TipoVenta            Int
  EstaEliminado        Boolean
  /// Tenant dueño de este artículo
  TenantId             BigInt
  Tenant               Tenant               @relation(fields: [TenantId], references: [Id])
  Iva                  Iva                  @relation(fields: [IvaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Iva_IvaId")
  Marca                Marca                @relation(fields: [MarcaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Marca_MarcaId")
  Precio               Precio               @relation(fields: [PrecioId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Precio_PrecioId")
  Rubro                Rubro                @relation(fields: [RubroId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.Rubro_RubroId")
  UnidadMedida         UnidadMedida         @relation(fields: [UnidadMedidaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Articulo_dbo.UnidadMedida_UnidadMedidaId")
  BajaArticulo         BajaArticulo[]
  DetalleComprobante   DetalleComprobante[]
  Stock                Stock[]

  @@index([TenantId])
  @@index([IvaId], map: "IX_IvaId")
  @@index([MarcaId], map: "IX_MarcaId")
  @@index([PrecioId], map: "IX_PrecioId")
  @@index([RubroId], map: "IX_RubroId")
  @@index([UnidadMedidaId], map: "IX_UnidadMedidaId")
}

/// Bajas de artículos (ajustes de stock por pérdida, rotura, etc.).
model BajaArticulo {
  Id            BigInt      @id(map: "PK_dbo.BajaArticulo") @default(autoincrement())
  ArticuloId    BigInt
  MotivoBajaId  BigInt
  Cantidad      Decimal     @db.Decimal(18, 2)
  Fecha         DateTime    @db.DateTime
  Observacion   String      @db.VarChar(400)
  EstaEliminado Boolean
  /// Tenant dueño de esta baja
  TenantId      BigInt
  Tenant        Tenant      @relation(fields: [TenantId], references: [Id])
  Articulo      Articulo    @relation(fields: [ArticuloId], references: [Id], onUpdate: NoAction, map: "FK_dbo.BajaArticulo_dbo.Articulo_ArticuloId")
  MotivoBajas   MotivoBajas @relation(fields: [MotivoBajaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.BajaArticulo_dbo.MotivoBajas_MotivoBajaId")

  @@index([TenantId])
  @@index([ArticuloId], map: "IX_ArticuloId")
  @@index([MotivoBajaId], map: "IX_MotivoBajaId")
}

/// Bancos utilizados por el comercio (para cheques, cuentas, etc.).
model Banco {
  Id              BigInt            @id(map: "PK_dbo.Banco") @default(autoincrement())
  Descripcion     String            @db.VarChar(250)
  EstaEliminado   Boolean
  /// Tenant dueño de este banco
  TenantId        BigInt
  Tenant          Tenant            @relation(fields: [TenantId], references: [Id])
  Cheque          Cheque[]
  CuentaBancarias CuentaBancarias[]

  @@index([TenantId])
}

/// Movimientos de caja por turno/apertura-cierre.
model Caja {
  Id                                      BigInt        @id(map: "PK_dbo.Caja") @default(autoincrement())
  UsuarioAperturaId                       BigInt
  MontoInicial                            Decimal       @db.Decimal(18, 2)
  FechaApertura                           DateTime      @db.DateTime
  UsuarioCierreId                         BigInt?
  FechaCierre                             DateTime?     @db.DateTime
  MontoCierre                             Decimal?      @db.Decimal(18, 2)
  TotalEntradaEfectivo                    Decimal       @db.Decimal(18, 2)
  TotalSalidaEfectivo                     Decimal       @db.Decimal(18, 2)
  TotalEntradaTarjeta                     Decimal       @db.Decimal(18, 2)
  TotalSalidaTarjeta                      Decimal       @db.Decimal(18, 2)
  TotalEntradaCheque                      Decimal       @db.Decimal(18, 2)
  TotalSalidaCheque                       Decimal       @db.Decimal(18, 2)
  TotalEntradaCtaCte                      Decimal       @db.Decimal(18, 2)
  TotalSalidaCtaCte                       Decimal       @db.Decimal(18, 2)
  TotalEntradaTransf                      Decimal       @db.Decimal(18, 2)
  TotalSalidaTransf                       Decimal       @db.Decimal(18, 2)
  EstaEliminado                           Boolean
  Ganancia                                Decimal       @default(0, map: "DF__Caja__Ganancia__0880433F") @db.Decimal(18, 2)
  /// Tenant dueño de esta caja
  TenantId                                BigInt
  Tenant                                  Tenant        @relation(fields: [TenantId], references: [Id])
  Usuario_Caja_UsuarioAperturaIdToUsuario Usuario       @relation("Caja_UsuarioAperturaIdToUsuario", fields: [UsuarioAperturaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Caja_dbo.Usuario_UsuarioAperturaId")
  Usuario_Caja_UsuarioCierreIdToUsuario   Usuario?      @relation("Caja_UsuarioCierreIdToUsuario", fields: [UsuarioCierreId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_dbo.Caja_dbo.Usuario_UsuarioCierreId")
  DetalleCaja                             DetalleCaja[]
  Gasto                                   Gasto[]
  Movimiento                              Movimiento[]

  @@index([TenantId])
  @@index([UsuarioAperturaId], map: "IX_UsuarioAperturaId")
  @@index([UsuarioCierreId], map: "IX_UsuarioCierreId")
}

/// Cheques recibidos de clientes.
model Cheque {
  Id               BigInt             @id(map: "PK_dbo.Cheque") @default(autoincrement())
  ClienteId        BigInt
  BancoId          BigInt
  Numero           String             @db.VarChar(100)
  FechaVencimiento DateTime           @db.DateTime
  EstaRechazado    Boolean
  EstaEliminado    Boolean
  /// Tenant dueño de este cheque
  TenantId         BigInt
  Tenant           Tenant             @relation(fields: [TenantId], references: [Id])
  Banco            Banco              @relation(fields: [BancoId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Cheque_dbo.Banco_BancoId")
  Persona_Cliente  Persona_Cliente    @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Cheque_dbo.Persona_Cliente_ClienteId")
  DepositoCheques  DepositoCheques[]
  FormaPago_Cheque FormaPago_Cheque[]

  @@index([TenantId])
  @@index([BancoId], map: "IX_BancoId")
  @@index([ClienteId], map: "IX_ClienteId")
}

/// Cabecera genérica de comprobantes (facturas, notas de crédito, presupuestos, etc.).
model Comprobante {
  Id                                                                         BigInt                       @id(map: "PK_dbo.Comprobante") @default(autoincrement())
  EmpleadoId                                                                 BigInt
  UsuarioId                                                                  BigInt
  Fecha                                                                      DateTime                     @db.DateTime
  Numero                                                                     Int
  SubTotal                                                                   Decimal                      @db.Decimal(18, 2)
  Descuento                                                                  Decimal                      @db.Decimal(18, 2)
  Total                                                                      Decimal                      @db.Decimal(18, 2)
  Iva21                                                                      Decimal                      @db.Decimal(18, 2)
  Iva105                                                                     Decimal                      @db.Decimal(18, 2)
  TipoComprobante                                                            Int
  EstaEliminado                                                              Boolean
  /// Tenant dueño de este comprobante
  TenantId                                                                   BigInt
  Tenant                                                                     Tenant                       @relation(fields: [TenantId], references: [Id])
  Persona_Empleado                                                           Persona_Empleado             @relation(fields: [EmpleadoId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_dbo.Persona_Empleado_EmpleadoId")
  Usuario                                                                    Usuario                      @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_dbo.Usuario_UsuarioId")
  Comprobante_Compra                                                         Comprobante_Compra?
  Comprobante_CtaCteProveedor                                                Comprobante_CtaCteProveedor?
  Comprobante_CuentaCorriente                                                Comprobante_CuentaCorriente?
  Comprobante_Factura                                                        Comprobante_Factura?
  Comprobante_NotaCredito_Comprobante_NotaCredito_ComprobanteIdToComprobante Comprobante_NotaCredito[]    @relation("Comprobante_NotaCredito_ComprobanteIdToComprobante")
  Comprobante_NotaCredito_Comprobante_NotaCredito_IdToComprobante            Comprobante_NotaCredito?     @relation("Comprobante_NotaCredito_IdToComprobante")
  Comprobante_Presupuesto                                                    Comprobante_Presupuesto?
  Comprobante_Remito                                                         Comprobante_Remito?
  DetalleComprobante                                                         DetalleComprobante[]
  FormaPago                                                                  FormaPago[]
  Movimiento                                                                 Movimiento[]

  @@index([TenantId])
  @@index([EmpleadoId], map: "IX_EmpleadoId")
  @@index([UsuarioId], map: "IX_UsuarioId")
}

/// Datos adicionales de comprobantes de compra.
model Comprobante_Compra {
  Id             BigInt      @id(map: "PK_dbo.Comprobante_Compra")
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ProveedorId    BigInt
  FechaEntrega   DateTime    @db.DateTime
  Iva27          Decimal     @db.Decimal(18, 2)
  PrecepcionTemp Decimal     @db.Decimal(18, 2)
  PrecepcionPyP  Decimal     @db.Decimal(18, 2)
  PrecepcionIva  Decimal     @db.Decimal(18, 2)
  PrecepcionIB   Decimal     @db.Decimal(18, 2)
  EstadoFactura  Int
  Comprobante    Comprobante @relation(fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Compra_dbo.Comprobante_Id")
  Proveedor      Proveedor   @relation(fields: [ProveedorId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Compra_dbo.Proveedor_ProveedorId")

  @@index([Id], map: "IX_Id")
  @@index([ProveedorId], map: "IX_ProveedorId")
}

/// Relación comprobante con cuenta corriente de proveedor.
model Comprobante_CtaCteProveedor {
  Id          BigInt      @id(map: "PK_dbo.Comprobante_CtaCteProveedor")
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ProveedorId BigInt
  Estado      Int
  Comprobante Comprobante @relation(fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_CtaCteProveedor_dbo.Comprobante_Id")
  Proveedor   Proveedor   @relation(fields: [ProveedorId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_CtaCteProveedor_dbo.Proveedor_ProveedorId")

  @@index([Id], map: "IX_Id")
  @@index([ProveedorId], map: "IX_ProveedorId")
}

/// Relación comprobante con movimiento de cuenta corriente de cliente.
model Comprobante_CuentaCorriente {
  Id                          BigInt                     @id(map: "PK_dbo.Comprobante_CuentaCorriente")
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId                   BigInt
  MovimientoCuentaCorrienteId BigInt
  Comprobante                 Comprobante                @relation(fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_CuentaCorriente_dbo.Comprobante_Id")
  Movimiento_CuentaCorriente  Movimiento_CuentaCorriente @relation(fields: [MovimientoCuentaCorrienteId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_CuentaCorriente_dbo.Movimiento_CuentaCorriente_MovimientoCuentaCorrienteId")
  Persona_Cliente             Persona_Cliente            @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_CuentaCorriente_dbo.Persona_Cliente_ClienteId")

  @@index([ClienteId], map: "IX_ClienteId")
  @@index([Id], map: "IX_Id")
  @@index([MovimientoCuentaCorrienteId], map: "IX_MovimientoCuentaCorrienteId")
}

/// Información de facturas (cliente y puesto de trabajo).
model Comprobante_Factura {
  Id              BigInt          @id(map: "PK_dbo.Comprobante_Factura")
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId       BigInt
  PuestoTrabajoId BigInt
  Estado          Int
  Comprobante     Comprobante     @relation(fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Factura_dbo.Comprobante_Id")
  Persona_Cliente Persona_Cliente @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Factura_dbo.Persona_Cliente_ClienteId")
  PuestoTrabajo   PuestoTrabajo   @relation(fields: [PuestoTrabajoId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Factura_dbo.PuestoTrabajo_PuestoTrabajoId")

  @@index([ClienteId], map: "IX_ClienteId")
  @@index([Id], map: "IX_Id")
  @@index([PuestoTrabajoId], map: "IX_PuestoTrabajoId")
}

/// Relación entre nota de crédito y comprobantes.
model Comprobante_NotaCredito {
  Id                                                             BigInt      @id(map: "PK_dbo.Comprobante_NotaCredito")
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ComprobanteId                                                  BigInt
  Comprobante_Comprobante_NotaCredito_ComprobanteIdToComprobante Comprobante @relation("Comprobante_NotaCredito_ComprobanteIdToComprobante", fields: [ComprobanteId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_NotaCredito_dbo.Comprobante_ComprobanteId")
  Comprobante_Comprobante_NotaCredito_IdToComprobante            Comprobante @relation("Comprobante_NotaCredito_IdToComprobante", fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_NotaCredito_dbo.Comprobante_Id")

  @@index([ComprobanteId], map: "IX_ComprobanteId")
  @@index([Id], map: "IX_Id")
}

/// Datos de presupuestos (asociados a cliente).
model Comprobante_Presupuesto {
  Id              BigInt          @id(map: "PK_dbo.Comprobante_Presupuesto")
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId       BigInt
  Comprobante     Comprobante     @relation(fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Presupuesto_dbo.Comprobante_Id")
  Persona_Cliente Persona_Cliente @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Presupuesto_dbo.Persona_Cliente_ClienteId")

  @@index([ClienteId], map: "IX_ClienteId")
  @@index([Id], map: "IX_Id")
}

/// Datos de remitos (asociados a cliente).
model Comprobante_Remito {
  Id              BigInt          @id(map: "PK_dbo.Comprobante_Remito")
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId       BigInt
  Comprobante     Comprobante     @relation(fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Remito_dbo.Comprobante_Id")
  Persona_Cliente Persona_Cliente @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Comprobante_Remito_dbo.Persona_Cliente_ClienteId")

  @@index([ClienteId], map: "IX_ClienteId")
  @@index([Id], map: "IX_Id")
}

/// Conceptos utilizados para clasificar gastos.
model ConceptoGastos {
  Id            BigInt  @id(map: "PK_dbo.ConceptoGastos") @default(autoincrement())
  Descripcion   String  @db.VarChar(250)
  EstaEliminado Boolean
  /// Tenant dueño de este concepto
  TenantId      BigInt
  Tenant        Tenant  @relation(fields: [TenantId], references: [Id])
  Gasto         Gasto[]

  @@index([TenantId])
}

/// Condiciones de IVA (Responsable Inscripto, Monotributista, etc.).
model CondicionIva {
  Id              BigInt            @id(map: "PK_dbo.CondicionIva") @default(autoincrement())
  Descripcion     String            @unique(map: "Index_Descripcion_CondicionIva") @db.VarChar(150)
  EstaEliminado   Boolean
  Persona_Cliente Persona_Cliente[]
  Proveedor       Proveedor[]
}

/// Configuración general del comercio (datos fiscales, parámetros de stock, etc.).
model Configuracion {
  Id                                     BigInt    @id(map: "PK_dbo.Configuracion") @default(autoincrement())
  RazonSocial                            String    @db.VarChar(250)
  NombreFantasia                         String?   @db.VarChar(250)
  Cuit                                   String    @db.VarChar(13)
  Telefono                               String?   @db.VarChar(25)
  Celular                                String?   @db.VarChar(25)
  Direccion                              String    @db.VarChar(400)
  Email                                  String?   @db.VarChar(250)
  LocalidadId                            BigInt
  FacturaDescuentaStock                  Boolean
  PresupuestoDescuentaStock              Boolean
  RemitoDescuentaStock                   Boolean
  ActualizaCostoDesdeCompra              Boolean
  ModificaPrecioVentaDesdeCompra         Boolean
  DepositoId                             BigInt
  Imprimir                               Boolean
  Instalada                              Int?
  TipoFormaPagoPorDefectoVenta           Int
  TipoFormaPagoPorDefectoCompra          Int
  ObservacionEnPieFactura                String?   @db.VarChar(400)
  UnificarRenglonesIngresarMismoProducto Boolean
  IngresoManualCajaInicial               Boolean
  PuestoCajaSeparado                     Boolean
  ActivarRetiroDeCaja                    Boolean
  MontoMaximoRetiroCaja                  Decimal   @db.Decimal(18, 2)
  ActivarBascula                         Boolean
  EtiquetaPorPeso                        Boolean
  CodigoBascula                          String?   @db.VarChar(8000)
  EstaEliminado                          Boolean
  Foto                                   Bytes?
  ShowFoto                               Boolean   @default(false, map: "DF__Configura__ShowF__19AACF41")
  /// Tenant dueño de esta configuración
  TenantId                               BigInt
  Tenant                                 Tenant    @relation(fields: [TenantId], references: [Id])
  Deposito                               Deposito  @relation(fields: [DepositoId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Configuracion_dbo.Deposito_DepositoId")
  Localidad                              Localidad @relation(fields: [LocalidadId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Configuracion_dbo.Localidad_LocalidadId")

  @@index([TenantId])
  @@index([DepositoId], map: "IX_DepositoId")
  @@index([LocalidadId], map: "IX_LocalidadId")
}

/// Contadores para numeración de comprobantes.
model Contador {
  Id              BigInt  @id(map: "PK_dbo.Contador") @default(autoincrement())
  TipoComprobante Int
  Valor           Int
  EstaEliminado   Boolean
  /// Tenant dueño de este contador
  TenantId        BigInt
  Tenant          Tenant  @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Cuentas bancarias del comercio.
model CuentaBancarias {
  Id              BigInt            @id(map: "PK_dbo.CuentaBancarias") @default(autoincrement())
  BancoId         BigInt
  Numero          String            @db.VarChar(100)
  Titular         String            @db.VarChar(250)
  EstaEliminado   Boolean
  /// Tenant dueño de esta cuenta bancaria
  TenantId        BigInt
  Tenant          Tenant            @relation(fields: [TenantId], references: [Id])
  Banco           Banco             @relation(fields: [BancoId], references: [Id], onUpdate: NoAction, map: "FK_dbo.CuentaBancarias_dbo.Banco_BancoId")
  DepositoCheques DepositoCheques[]

  @@index([TenantId])
  @@index([BancoId], map: "IX_BancoId")
}

/// Departamentos (subdivisión de provincia).
model Departamento {
  Id            BigInt      @id(map: "PK_dbo.Departamento") @unique(map: "UX_Departamento_Id")
  ProvinciaId   BigInt
