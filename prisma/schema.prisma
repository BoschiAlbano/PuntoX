  TenantId          BigInt
  FormaPago_Tarjeta FormaPago_Tarjeta[]
  Tenant            Tenant              @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Unidades de medida para artículos (kg, unidad, litro, etc.).
model UnidadMedida {
  Id            BigInt     @id(map: "PK_dbo.UnidadMedida") @default(autoincrement())
  Descripcion   String     @db.VarChar(250)
  EstaEliminado Boolean
  /// Tenant dueño de esta unidad
  TenantId      BigInt
  Articulo      Articulo[]
  Tenant        Tenant     @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Usuarios del sistema (login), asociados a Persona_Empleado.
model Usuario {
  Id                                   BigInt           @id(map: "PK_dbo.Usuario") @default(autoincrement())
  EmpleadoId                           BigInt
  Nombre                               String           @db.VarChar(50)
  Password                             String           @db.VarChar(400)
  EstaBloqueado                        Boolean
  EstaEliminado                        Boolean
  /// Tenant dueño de este usuario
  TenantId                             BigInt
  Caja_Caja_UsuarioAperturaIdToUsuario Caja[]           @relation("Caja_UsuarioAperturaIdToUsuario")
  Caja_Caja_UsuarioCierreIdToUsuario   Caja[]           @relation("Caja_UsuarioCierreIdToUsuario")
  Comprobante                          Comprobante[]
  Movimiento                           Movimiento[]
  PerfilUsuario                        PerfilUsuario[]
  Persona_Empleado                     Persona_Empleado @relation(fields: [EmpleadoId], references: [Id], onUpdate: NoAction, map: "FK_dbo.Usuario_dbo.Persona_Empleado_EmpleadoId")
  Tenant                               Tenant           @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([EmpleadoId], map: "IX_EmpleadoId")
}
