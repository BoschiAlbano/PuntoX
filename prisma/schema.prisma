generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Representa un comercio/cliente del SaaS.
/// Todo lo que tiene TenantId pertenece a este Tenant.
model Tenant {
  Id                  BigInt               @id @default(autoincrement())
  Nombre              String               @db.VarChar(250)
  Dominio             String?              @unique @db.VarChar(400)
  RazonSocial         String?              @db.VarChar(250)
  Cuit                String?              @db.VarChar(20)
  Email               String?              @db.VarChar(250)
  Telefono            String?              @db.VarChar(25)
  EstaActivo          Boolean              @default(true)
  PlanId              BigInt?
  OnboardingCompleto  Boolean              @default(false)
  Articulos           Articulo[]
  BajaArticulos       BajaArticulo[]
  Bancos              Banco[]
  Cajas               Caja[]
  Cheques             Cheque[]
  Comprobantes        Comprobante[]
  ConceptosGasto      ConceptoGastos[]
  Configuraciones     Configuracion[]
  Contadores          Contador[]
  CuentasBancarias    CuentaBancarias[]
  DepositosCheques    DepositoCheques[]
  DetallesCaja        DetalleCaja[]
  DetallesComprobante DetalleComprobante[]
  FormasPago          FormaPago[]
  FormulariosPerfiles FormularioPerfil[]
  FormulariosPermisos Formularios[]
  Gastos              Gasto[]
  Logs                Log[]
  Marcas              Marca[]
  MotivosBaja         MotivoBajas[]
  Movimientos         Movimiento[]
  PerfilesUsuarios    PerfilUsuario[]
  Perfiles            Perfiles[]
  Permisos            Permiso[]
  PerfilPermisos      PerfilPermiso[]
  Personas            Persona[]
  Precios             Precio[]
  Proveedores         Proveedor[]
  PuestosTrabajo      PuestoTrabajo[]
  Rubros              Rubro[]
  Stocks              Stock[]
  Tarjetas            Tarjeta[]
  Plan                PlanSaaS?            @relation(fields: [PlanId], references: [Id])
  Unidades            UnidadMedida[]
  Usuarios            Usuario[]

  @@index([PlanId])
}

/// Planes de suscripción SaaS disponibles (global)
model PlanSaaS {
  Id              BigInt   @id @default(autoincrement())
  Nombre          String   @unique @db.VarChar(200)
  Descripcion     String?  @db.VarChar(800)
  CostoMensual    Decimal  @db.Decimal(18, 2)
  /// Características adicionales (texto/JSON serializado)
  Caracteristicas String?  @db.VarChar(4000)
  Tenants         Tenant[]
}

/// Logs de aplicacion; TenantId nullable permite logs globales o por tenant
model Log {
  Id       BigInt   @id @default(autoincrement())
  TenantId BigInt?
  Fecha    DateTime @default(now())
  Nivel    String   @db.VarChar(50)
  Servicio String?  @db.VarChar(200)
  Mensaje  String   @db.VarChar(4000)
  Metadata String?  @db.VarChar(4000)
  Tenant   Tenant?  @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([Fecha])
}

/// Artículos/Productos del comercio. Incluye datos de stock y atributos comerciales.
model Articulo {
  Id                   BigInt               @id @default(autoincrement())
  MarcaId              BigInt
  RubroId              BigInt
  UnidadMedidaId       BigInt
  IvaId                BigInt
  PrecioId             BigInt
  Codigo               Int
  CodigoBarra          String               @db.VarChar(100)
  Abreviatura          String?              @db.VarChar(20)
  Descripcion          String               @db.VarChar(250)
  Detalle              String?              @db.VarChar(500)
  Ubicacion            String?              @db.VarChar(500)
  PrecioCosto          Decimal              @db.Decimal(18, 2)
  PorcentajeGanancia   Decimal              @db.Decimal(18, 2)
  Foto                 Bytes
  ActivarLimiteVenta   Boolean
  LimiteVenta          Decimal              @db.Decimal(18, 2)
  ActivarHoraVenta     Boolean
  HoraLimiteVentaDesde DateTime
  HoraLimiteVentaHasta DateTime
  PermiteStockNegativo Boolean
  DescuentaStock       Boolean
  StockMinimo          Decimal              @db.Decimal(18, 2)
  VencimientoDias      Int
  TipoVenta            Int
  EstaEliminado        Boolean
  /// Tenant dueño de este artículo
  TenantId             BigInt
  Iva                  Iva                  @relation(fields: [IvaId], references: [Id], onUpdate: NoAction)
  Marca                Marca                @relation(fields: [MarcaId], references: [Id], onUpdate: NoAction)
  Precio               Precio               @relation(fields: [PrecioId], references: [Id], onUpdate: NoAction)
  Rubro                Rubro                @relation(fields: [RubroId], references: [Id], onUpdate: NoAction)
  Tenant               Tenant               @relation(fields: [TenantId], references: [Id])
  UnidadMedida         UnidadMedida         @relation(fields: [UnidadMedidaId], references: [Id], onUpdate: NoAction)
  BajaArticulo         BajaArticulo[]
  DetalleComprobante   DetalleComprobante[]
  Stock                Stock[]

  @@index([TenantId])
  @@index([IvaId])
  @@index([MarcaId])
  @@index([PrecioId])
  @@index([RubroId])
  @@index([UnidadMedidaId])
}

/// Bajas de artículos (ajustes de stock por pérdida, rotura, etc.).
model BajaArticulo {
  Id            BigInt      @id @default(autoincrement())
  ArticuloId    BigInt
  MotivoBajaId  BigInt
  Cantidad      Decimal     @db.Decimal(18, 2)
  Fecha         DateTime
  Observacion   String      @db.VarChar(400)
  EstaEliminado Boolean
  /// Tenant dueño de esta baja
  TenantId      BigInt
  Articulo      Articulo    @relation(fields: [ArticuloId], references: [Id], onUpdate: NoAction)
  MotivoBajas   MotivoBajas @relation(fields: [MotivoBajaId], references: [Id], onUpdate: NoAction)
  Tenant        Tenant      @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([ArticuloId])
  @@index([MotivoBajaId])
}

/// Bancos utilizados por el comercio (para cheques, cuentas, etc.).
model Banco {
  Id              BigInt            @id @default(autoincrement())
  Descripcion     String            @db.VarChar(250)
  EstaEliminado   Boolean
  /// Tenant dueño de este banco
  TenantId        BigInt
  Tenant          Tenant            @relation(fields: [TenantId], references: [Id])
  Cheque          Cheque[]
  CuentaBancarias CuentaBancarias[]

  @@index([TenantId])
}

/// Movimientos de caja por turno/apertura-cierre.
model Caja {
  Id                                      BigInt        @id @default(autoincrement())
  UsuarioAperturaId                       BigInt
  MontoInicial                            Decimal       @db.Decimal(18, 2)
  FechaApertura                           DateTime
  UsuarioCierreId                         BigInt?
  FechaCierre                             DateTime?
  MontoCierre                             Decimal?      @db.Decimal(18, 2)
  TotalEntradaEfectivo                    Decimal       @db.Decimal(18, 2)
  TotalSalidaEfectivo                     Decimal       @db.Decimal(18, 2)
  TotalEntradaTarjeta                     Decimal       @db.Decimal(18, 2)
  TotalSalidaTarjeta                      Decimal       @db.Decimal(18, 2)
  TotalEntradaCheque                      Decimal       @db.Decimal(18, 2)
  TotalSalidaCheque                       Decimal       @db.Decimal(18, 2)
  TotalEntradaCtaCte                      Decimal       @db.Decimal(18, 2)
  TotalSalidaCtaCte                       Decimal       @db.Decimal(18, 2)
  TotalEntradaTransf                      Decimal       @db.Decimal(18, 2)
  TotalSalidaTransf                       Decimal       @db.Decimal(18, 2)
  EstaEliminado                           Boolean
  Ganancia                                Decimal       @default(0) @db.Decimal(18, 2)
  /// Tenant dueño de esta caja
  TenantId                                BigInt
  Tenant                                  Tenant        @relation(fields: [TenantId], references: [Id])
  Usuario_Caja_UsuarioAperturaIdToUsuario Usuario       @relation("Caja_UsuarioAperturaIdToUsuario", fields: [UsuarioAperturaId], references: [Id], onUpdate: NoAction)
  Usuario_Caja_UsuarioCierreIdToUsuario   Usuario?      @relation("Caja_UsuarioCierreIdToUsuario", fields: [UsuarioCierreId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  DetalleCaja                             DetalleCaja[]
  Gasto                                   Gasto[]
  Movimiento                              Movimiento[]

  @@index([TenantId])
  @@index([UsuarioAperturaId])
  @@index([UsuarioCierreId])
}

/// Cheques recibidos de clientes.
model Cheque {
  Id               BigInt             @id @default(autoincrement())
  ClienteId        BigInt
  BancoId          BigInt
  Numero           String             @db.VarChar(100)
  FechaVencimiento DateTime
  EstaRechazado    Boolean
  EstaEliminado    Boolean
  /// Tenant dueño de este cheque
  TenantId         BigInt
  Banco            Banco              @relation(fields: [BancoId], references: [Id], onUpdate: NoAction)
  Persona_Cliente  Persona_Cliente    @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  Tenant           Tenant             @relation(fields: [TenantId], references: [Id])
  DepositoCheques  DepositoCheques[]
  FormaPago_Cheque FormaPago_Cheque[]

  @@index([TenantId])
  @@index([BancoId])
  @@index([ClienteId])
}

/// Cabecera genérica de comprobantes (facturas, notas de crédito, presupuestos, etc.).
model Comprobante {
  Id                                                                         BigInt                       @id @default(autoincrement())
  EmpleadoId                                                                 BigInt
  UsuarioId                                                                  BigInt
  Fecha                                                                      DateTime
  Numero                                                                     Int
  SubTotal                                                                   Decimal                      @db.Decimal(18, 2)
  Descuento                                                                  Decimal                      @db.Decimal(18, 2)
  Total                                                                      Decimal                      @db.Decimal(18, 2)
  Iva21                                                                      Decimal                      @db.Decimal(18, 2)
  Iva105                                                                     Decimal                      @db.Decimal(18, 2)
  TipoComprobante                                                            Int
  EstaEliminado                                                              Boolean
  /// Tenant dueño de este comprobante
  TenantId                                                                   BigInt
  Persona_Empleado                                                           Persona_Empleado             @relation(fields: [EmpleadoId], references: [Id], onUpdate: NoAction)
  Tenant                                                                     Tenant                       @relation(fields: [TenantId], references: [Id])
  Usuario                                                                    Usuario                      @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction)
  Comprobante_Compra                                                         Comprobante_Compra?
  Comprobante_CtaCteProveedor                                                Comprobante_CtaCteProveedor?
  Comprobante_CuentaCorriente                                                Comprobante_CuentaCorriente?
  Comprobante_Factura                                                        Comprobante_Factura?
  Comprobante_NotaCredito_Comprobante_NotaCredito_ComprobanteIdToComprobante Comprobante_NotaCredito[]    @relation("Comprobante_NotaCredito_ComprobanteIdToComprobante")
  Comprobante_NotaCredito_Comprobante_NotaCredito_IdToComprobante            Comprobante_NotaCredito?     @relation("Comprobante_NotaCredito_IdToComprobante")
  Comprobante_Presupuesto                                                    Comprobante_Presupuesto?
  Comprobante_Remito                                                         Comprobante_Remito?
  DetalleComprobante                                                         DetalleComprobante[]
  FormaPago                                                                  FormaPago[]
  Movimiento                                                                 Movimiento[]

  @@index([TenantId])
  @@index([EmpleadoId])
  @@index([UsuarioId])
}

/// Datos adicionales de comprobantes de compra.
model Comprobante_Compra {
  Id             BigInt      @id
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ProveedorId    BigInt
  FechaEntrega   DateTime
  Iva27          Decimal     @db.Decimal(18, 2)
  PrecepcionTemp Decimal     @db.Decimal(18, 2)
  PrecepcionPyP  Decimal     @db.Decimal(18, 2)
  PrecepcionIva  Decimal     @db.Decimal(18, 2)
  PrecepcionIB   Decimal     @db.Decimal(18, 2)
  EstadoFactura  Int
  Comprobante    Comprobante @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  Proveedor      Proveedor   @relation(fields: [ProveedorId], references: [Id], onUpdate: NoAction)

  @@index([Id])
  @@index([ProveedorId])
}

enum PerfilTipo {
  ADMINISTRADOR
  EMPLEADO
}

/// Relación comprobante con cuenta corriente de proveedor.
model Comprobante_CtaCteProveedor {
  Id          BigInt      @id
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ProveedorId BigInt
  Estado      Int
  Comprobante Comprobante @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  Proveedor   Proveedor   @relation(fields: [ProveedorId], references: [Id], onUpdate: NoAction)

  @@index([Id])
  @@index([ProveedorId])
}

/// Relación comprobante con movimiento de cuenta corriente de cliente.
model Comprobante_CuentaCorriente {
  Id                          BigInt                     @id
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId                   BigInt
  MovimientoCuentaCorrienteId BigInt
  Persona_Cliente             Persona_Cliente            @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  Comprobante                 Comprobante                @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  Movimiento_CuentaCorriente  Movimiento_CuentaCorriente @relation(fields: [MovimientoCuentaCorrienteId], references: [Id], onUpdate: NoAction)

  @@index([ClienteId])
  @@index([Id])
  @@index([MovimientoCuentaCorrienteId])
}

/// Información de facturas (cliente y puesto de trabajo).
model Comprobante_Factura {
  Id              BigInt          @id
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId       BigInt
  PuestoTrabajoId BigInt
  Estado          Int
  Persona_Cliente Persona_Cliente @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  Comprobante     Comprobante     @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  PuestoTrabajo   PuestoTrabajo   @relation(fields: [PuestoTrabajoId], references: [Id], onUpdate: NoAction)

  @@index([ClienteId])
  @@index([Id])
  @@index([PuestoTrabajoId])
}

/// Relación entre nota de crédito y comprobantes.
model Comprobante_NotaCredito {
  Id                                                             BigInt      @id
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ComprobanteId                                                  BigInt
  Comprobante_Comprobante_NotaCredito_ComprobanteIdToComprobante Comprobante @relation("Comprobante_NotaCredito_ComprobanteIdToComprobante", fields: [ComprobanteId], references: [Id], onUpdate: NoAction)
  Comprobante_Comprobante_NotaCredito_IdToComprobante            Comprobante @relation("Comprobante_NotaCredito_IdToComprobante", fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([ComprobanteId])
  @@index([Id])
}

/// Datos de presupuestos (asociados a cliente).
model Comprobante_Presupuesto {
  Id              BigInt          @id
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId       BigInt
  Persona_Cliente Persona_Cliente @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  Comprobante     Comprobante     @relation(fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([ClienteId])
  @@index([Id])
}

/// Datos de remitos (asociados a cliente).
model Comprobante_Remito {
  Id              BigInt          @id
  /// Hereda TenantId desde Comprobante (Id es PK y FK)
  ClienteId       BigInt
  Persona_Cliente Persona_Cliente @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  Comprobante     Comprobante     @relation(fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([ClienteId])
  @@index([Id])
}

/// Conceptos utilizados para clasificar gastos.
model ConceptoGastos {
  Id            BigInt  @id @default(autoincrement())
  Descripcion   String  @db.VarChar(250)
  EstaEliminado Boolean
  /// Tenant dueño de este concepto
  TenantId      BigInt
  Tenant        Tenant  @relation(fields: [TenantId], references: [Id])
  Gasto         Gasto[]

  @@index([TenantId])
}

/// Condiciones de IVA (Responsable Inscripto, Monotributista, etc.).
model CondicionIva {
  Id              BigInt            @id @default(autoincrement())
  Descripcion     String            @unique @db.VarChar(150)
  EstaEliminado   Boolean
  Persona_Cliente Persona_Cliente[]
  Proveedor       Proveedor[]
}

/// Configuración general del comercio (datos fiscales, parámetros de stock, etc.).
model Configuracion {
  Id                                     BigInt    @id @default(autoincrement())
  RazonSocial                            String    @db.VarChar(250)
  NombreFantasia                         String?   @db.VarChar(250)
  Cuit                                   String    @db.VarChar(13)
  Telefono                               String?   @db.VarChar(25)
  Celular                                String?   @db.VarChar(25)
  Direccion                              String    @db.VarChar(400)
  Email                                  String?   @db.VarChar(250)
  LocalidadId                            BigInt
  FacturaDescuentaStock                  Boolean
  PresupuestoDescuentaStock              Boolean
  RemitoDescuentaStock                   Boolean
  ActualizaCostoDesdeCompra              Boolean
  ModificaPrecioVentaDesdeCompra         Boolean
  Imprimir                               Boolean
  Instalada                              Int?
  TipoFormaPagoPorDefectoVenta           Int
  TipoFormaPagoPorDefectoCompra          Int
  ObservacionEnPieFactura                String?   @db.VarChar(400)
  UnificarRenglonesIngresarMismoProducto Boolean
  IngresoManualCajaInicial               Boolean
  PuestoCajaSeparado                     Boolean
  ActivarRetiroDeCaja                    Boolean
  MontoMaximoRetiroCaja                  Decimal   @db.Decimal(18, 2)
  ActivarBascula                         Boolean
  EtiquetaPorPeso                        Boolean
  CodigoBascula                          String?   @db.VarChar(8000)
  MostrarPreciosConIva                   Boolean   @default(true)
  AbrirCajonEfectivo                     Boolean   @default(true)
  NumerarPedidosPantalla                 Boolean   @default(true)
  EstaEliminado                          Boolean
  Foto                                   Bytes?
  ShowFoto                               Boolean   @default(false)
  /// Tenant dueño de esta configuración
  TenantId                               BigInt
  Localidad                              Localidad @relation(fields: [LocalidadId], references: [Id], onUpdate: NoAction)
  Tenant                                 Tenant    @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([LocalidadId])
}

/// Contadores para numeración de comprobantes.
model Contador {
  Id              BigInt  @id @default(autoincrement())
  TipoComprobante Int
  Valor           Int
  EstaEliminado   Boolean
  /// Tenant dueño de este contador
  TenantId        BigInt
  Tenant          Tenant  @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Cuentas bancarias del comercio.
model CuentaBancarias {
  Id              BigInt            @id @default(autoincrement())
  BancoId         BigInt
  Numero          String            @db.VarChar(100)
  Titular         String            @db.VarChar(250)
  EstaEliminado   Boolean
  /// Tenant dueño de esta cuenta bancaria
  TenantId        BigInt
  Banco           Banco             @relation(fields: [BancoId], references: [Id], onUpdate: NoAction)
  Tenant          Tenant            @relation(fields: [TenantId], references: [Id])
  DepositoCheques DepositoCheques[]

  @@index([TenantId])
  @@index([BancoId])
}

/// Provincias (catálogo fijo, lo carga el sistema).
/// Los clientes solo seleccionan una provincia, no la crean.
model Provincia {
  Id            BigInt         @id @default(autoincrement())
  Descripcion   String         @unique @db.VarChar(100)
  EstaEliminado Boolean        @default(false)
  Departamento  Departamento[]
}

/// Departamentos (subdivisión de provincia).
/// Podés tratarlos como catálogo pre-cargado o ir agregando.
model Departamento {
  Id            BigInt      @id @default(autoincrement())
  ProvinciaId   BigInt
  Descripcion   String      @db.VarChar(250)
  EstaEliminado Boolean     @default(false)
  Provincia     Provincia   @relation(fields: [ProvinciaId], references: [Id], onUpdate: NoAction)
  Localidad     Localidad[]

  @@unique([ProvinciaId, Descripcion])
}

/// Localidades (ciudad/pueblo).
/// Estas sí las puede crear el cliente desde el sistema.
model Localidad {
  Id             BigInt          @id @default(autoincrement())
  DepartamentoId BigInt
  Descripcion    String          @db.VarChar(250)
  EstaEliminado  Boolean         @default(false)
  Configuracion  Configuracion[]
  Departamento   Departamento    @relation(fields: [DepartamentoId], references: [Id], onUpdate: NoAction)
  Persona        Persona[]
  Proveedor      Proveedor[]
}

/// Depósitos de cheques en cuentas bancarias.
model DepositoCheques {
  Id               BigInt          @id @default(autoincrement())
  ChequeId         BigInt
  CuentaBancariaId BigInt
  Fecha            DateTime
  EstaEliminado    Boolean
  /// Tenant dueño de este depósito de cheques
  TenantId         BigInt
  Cheque           Cheque          @relation(fields: [ChequeId], references: [Id], onUpdate: NoAction)
  CuentaBancarias  CuentaBancarias @relation(fields: [CuentaBancariaId], references: [Id], onUpdate: NoAction)
  Tenant           Tenant          @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([ChequeId])
  @@index([CuentaBancariaId])
}

/// Detalle resumido por tipo de pago en la caja.
model DetalleCaja {
  Id            BigInt  @id @default(autoincrement())
  CajaId        BigInt
  TipoPago      Int
  Monto         Decimal @db.Decimal(18, 2)
  EstaEliminado Boolean
  /// Tenant dueño de este detalle
  TenantId      BigInt
  Caja          Caja    @relation(fields: [CajaId], references: [Id], onUpdate: NoAction)
  Tenant        Tenant  @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([CajaId])
}

/// Renglones de cada comprobante (detalle de venta/compra).
model DetalleComprobante {
  Id            BigInt      @id @default(autoincrement())
  ComprobanteId BigInt
  ArticuloId    BigInt
  Codigo        String      @db.VarChar(8000)
  Descripcion   String      @db.VarChar(8000)
  Cantidad      Decimal     @db.Decimal(18, 3)
  Iva           Decimal     @db.Decimal(18, 2)
  Precio        Decimal     @db.Decimal(18, 2)
  SubTotal      Decimal     @db.Decimal(18, 2)
  EstaEliminado Boolean
  Costo         Decimal     @default(0) @db.Decimal(18, 2)
  /// Tenant dueño de este detalle
  TenantId      BigInt
  Articulo      Articulo    @relation(fields: [ArticuloId], references: [Id], onUpdate: NoAction)
  Comprobante   Comprobante @relation(fields: [ComprobanteId], references: [Id], onUpdate: NoAction)
  Tenant        Tenant      @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([ArticuloId])
  @@index([ComprobanteId])
}

/// Pagos asociados a comprobantes (monto y tipo de pago).
model FormaPago {
  Id                BigInt             @id @default(autoincrement())
  ComprobanteId     BigInt
  TipoPago          Int
  Monto             Decimal            @db.Decimal(18, 2)
  EstaEliminado     Boolean
  /// Tenant dueño de esta forma de pago
  TenantId          BigInt
  Comprobante       Comprobante        @relation(fields: [ComprobanteId], references: [Id], onUpdate: NoAction)
  Tenant            Tenant             @relation(fields: [TenantId], references: [Id])
  FormaPago_Cheque  FormaPago_Cheque?
  FormaPago_CtaCte  FormaPago_CtaCte?
  FormaPago_Tarjeta FormaPago_Tarjeta?

  @@index([TenantId])
  @@index([ComprobanteId])
}

/// Asociación de forma de pago con un cheque concreto.
model FormaPago_Cheque {
  Id        BigInt    @id
  /// Hereda TenantId desde FormaPago (Id es PK y FK)
  ChequeId  BigInt
  Cheque    Cheque    @relation(fields: [ChequeId], references: [Id], onUpdate: NoAction)
  FormaPago FormaPago @relation(fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([ChequeId])
  @@index([Id])
}

/// Asociación de forma de pago con cuenta corriente de cliente.
model FormaPago_CtaCte {
  Id              BigInt          @id
  /// Hereda TenantId desde FormaPago (Id es PK y FK)
  ClienteId       BigInt
  Persona_Cliente Persona_Cliente @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  FormaPago       FormaPago       @relation(fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([ClienteId])
  @@index([Id])
}

/// Asociación de forma de pago con tarjeta (datos de la operación).
model FormaPago_Tarjeta {
  Id             BigInt    @id
  /// Hereda TenantId desde FormaPago (Id es PK y FK)
  TarjetaId      BigInt
  NumeroTarjeta  String    @db.VarChar(100)
  CuponPago      String    @db.VarChar(100)
  CantidadCuotas Int
  FormaPago      FormaPago @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  Tarjeta        Tarjeta   @relation(fields: [TarjetaId], references: [Id], onUpdate: NoAction)

  @@index([Id])
  @@index([TarjetaId])
}

/// Relación muchos a muchos entre formularios y perfiles (permisos por pantalla).
model FormularioPerfil {
  Formulario_Id BigInt
  Perfil_Id     BigInt
  /// Tenant dueño de esta relación formulario-perfil
  TenantId      BigInt
  Formularios   Formularios @relation(fields: [Formulario_Id], references: [Id], onUpdate: NoAction)
  Perfiles      Perfiles    @relation(fields: [Perfil_Id], references: [Id], onUpdate: NoAction)
  Tenant        Tenant      @relation(fields: [TenantId], references: [Id])

  @@id([Formulario_Id, Perfil_Id])
  @@index([TenantId])
  @@index([Formulario_Id])
  @@index([Perfil_Id])
}

/// Formularios o pantallas del sistema (usados para permisos).
model Formularios {
  Id               BigInt             @id @default(autoincrement())
  Codigo           Int
  Nombre           String             @db.VarChar(250)
  NombreCompleto   String             @db.VarChar(400)
  EstaEliminado    Boolean
  /// Tenant dueño de este formulario
  TenantId         BigInt
  FormularioPerfil FormularioPerfil[]
  Tenant           Tenant             @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Gastos registrados en caja, asociados a un concepto.
model Gasto {
  Id              BigInt         @id @default(autoincrement())
  CajaId          BigInt
  ConceptoGastoId BigInt
  Fecha           DateTime
  Descripcion     String         @db.VarChar(400)
  Monto           Decimal        @db.Decimal(18, 2)
  EstaEliminado   Boolean
  /// Tenant dueño de este gasto
  TenantId        BigInt
  Caja            Caja           @relation(fields: [CajaId], references: [Id], onUpdate: NoAction)
  ConceptoGastos  ConceptoGastos @relation(fields: [ConceptoGastoId], references: [Id], onUpdate: NoAction)
  Tenant          Tenant         @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([CajaId])
  @@index([ConceptoGastoId])
}

/// Tabla de tipos de IVA disponibles.
model Iva {
  Id            BigInt     @id @default(autoincrement())
  Descripcion   String     @db.VarChar(250)
  Porcentaje    Decimal    @db.Decimal(18, 2)
  EstaEliminado Boolean
  Articulo      Articulo[]
}

/// Marcas de articulos (Nike, Samsung, etc.).
model Marca {
  Id            BigInt     @id @default(autoincrement())
  Descripcion   String     @db.VarChar(250)
  EstaEliminado Boolean
  /// Tenant dueno de esta marca
  TenantId      BigInt
  Articulo      Articulo[]
  Tenant        Tenant     @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Motivos para dar de baja articulos (vencimiento, rotura, etc.).
model MotivoBajas {
  Id            BigInt         @id @default(autoincrement())
  Descripcion   String         @db.VarChar(250)
  EstaEliminado Boolean
  /// Tenant dueno de este motivo
  TenantId      BigInt
  BajaArticulo  BajaArticulo[]
  Tenant        Tenant         @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Perfiles/roles de usuario (Admin, Cajero, Vendedor, etc.).
model Perfiles {
  Id               BigInt             @id @default(autoincrement())
  Descripcion      String             @db.VarChar(250)
  Tipo             PerfilTipo         @default(EMPLEADO)
  EstaEliminado    Boolean
  /// Tenant dueño de este perfil
  TenantId         BigInt
  FormularioPerfil FormularioPerfil[]
  PerfilUsuario    PerfilUsuario[]
  Tenant           Tenant             @relation(fields: [TenantId], references: [Id])
  PerfilPermiso    PerfilPermiso[]

  @@index([TenantId])
}

/// Permisos disponibles por tenant (permisos funcionales que se pueden asignar a un rol).
model Permiso {
  Id             BigInt          @id @default(autoincrement())
  Clave          String          @db.VarChar(100)
  Descripcion    String?         @db.VarChar(250)
  EstaEliminado  Boolean         @default(false)
  TenantId       BigInt
  PerfilPermisos PerfilPermiso[]
  Tenant         Tenant          @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@unique([Clave, TenantId])
}

/// RelaciГіn muchos a muchos entre perfiles (roles) y permisos.
model PerfilPermiso {
  PerfilId  BigInt
  PermisoId BigInt
  TenantId  BigInt

  Perfil    Perfiles @relation(fields: [PerfilId], references: [Id], onDelete: Cascade)
  Permiso   Permiso  @relation(fields: [PermisoId], references: [Id], onDelete: Cascade)
  Tenant    Tenant   @relation(fields: [TenantId], references: [Id])

  @@id([PerfilId, PermisoId])
  @@index([TenantId])
}

/// Relación muchos a muchos entre usuario y perfil.
model PerfilUsuario {
  Perfil_Id  BigInt
  Usuario_Id BigInt
  /// Tenant dueño de esta relación usuario-perfil
  TenantId   BigInt
  Perfiles   Perfiles @relation(fields: [Perfil_Id], references: [Id], onUpdate: NoAction)
  Tenant     Tenant   @relation(fields: [TenantId], references: [Id])
  Usuario    Usuario  @relation(fields: [Usuario_Id], references: [Id], onUpdate: NoAction)

  @@id([Perfil_Id, Usuario_Id])
  @@index([TenantId])
  @@index([Perfil_Id])
  @@index([Usuario_Id])
}

/// Persona genérica (base para cliente y empleado).
model Persona {
  Id               BigInt            @id @default(autoincrement())
  Apellido         String            @db.VarChar(150)
  Nombre           String            @db.VarChar(200)
  Dni              String?           @db.VarChar(8)
  Direccion        String            @db.VarChar(400)
  Telefono         String?           @db.VarChar(25)
  Mail             String            @db.VarChar(250)
  LocalidadId      BigInt
  EstaEliminado    Boolean
  /// Tenant dueño de esta persona
  TenantId         BigInt
  Localidad        Localidad         @relation(fields: [LocalidadId], references: [Id], onUpdate: NoAction)
  Tenant           Tenant            @relation(fields: [TenantId], references: [Id])
  Persona_Cliente  Persona_Cliente?
  Persona_Empleado Persona_Empleado?

  @@index([TenantId])
  @@index([LocalidadId])
}

/// Información específica de cliente (condición IVA, límites de cuenta corriente, etc.).
model Persona_Cliente {
  Id                          BigInt                        @id
  /// Hereda TenantId desde Persona (Id es PK y FK)
  CondicionIvaId              BigInt
  ActivarCtaCte               Boolean
  TieneLimiteCompra           Boolean
  MontoMaximoCtaCte           Decimal                       @db.Decimal(18, 2)
  Cheque                      Cheque[]
  Comprobante_CuentaCorriente Comprobante_CuentaCorriente[]
  Comprobante_Factura         Comprobante_Factura[]
  Comprobante_Presupuesto     Comprobante_Presupuesto[]
  Comprobante_Remito          Comprobante_Remito[]
  FormaPago_CtaCte            FormaPago_CtaCte[]
  Movimiento_CuentaCorriente  Movimiento_CuentaCorriente[]
  CondicionIva                CondicionIva                  @relation(fields: [CondicionIvaId], references: [Id], onUpdate: NoAction)
  Persona                     Persona                       @relation(fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([CondicionIvaId])
  @@index([Id])
}

/// Información específica de empleado (legajo, foto) vinculada a Persona.
model Persona_Empleado {
  Id          BigInt        @id
  /// Hereda TenantId desde Persona (Id es PK y FK)
  Legajo      Int
  Foto        Bytes
  Comprobante Comprobante[]
  Persona     Persona       @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  Usuario     Usuario[]

  @@index([Id])
}

/// Precios asociados a artículos (estructura heredada).
/// OJO: el diseño original es medio raro (Precio <-> Articulo).
model Precio {
  Id                  BigInt     @id @default(autoincrement())
  ArticuloId          BigInt
  PrecioCosto         Decimal    @db.Decimal(18, 2)
  PorcentajeGanancia  Decimal    @db.Decimal(18, 2)
  PrecioPublico       Decimal    @db.Decimal(18, 2)
  PorcentajeGanancia2 Decimal    @db.Decimal(18, 2)
  PrecioPublico2      Decimal    @db.Decimal(18, 2)
  FechaActualizacion  DateTime
  EstaEliminado       Boolean
  /// Tenant dueño de este precio
  TenantId            BigInt
  Articulo            Articulo[]
  Tenant              Tenant     @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Proveedores del comercio.
model Proveedor {
  Id                                  BigInt                                @id @default(autoincrement())
  RazonSocial                         String                                @db.VarChar(250)
  CUIT                                String                                @db.VarChar(15)
  Direccion                           String                                @db.VarChar(400)
  Telefono                            String?                               @db.VarChar(25)
  Mail                                String                                @db.VarChar(250)
  LocalidadId                         BigInt
  CondicionIvaId                      BigInt
  EstaEliminado                       Boolean
  /// Tenant dueño de este proveedor
  TenantId                            BigInt
  Comprobante_Compra                  Comprobante_Compra[]
  Comprobante_CtaCteProveedor         Comprobante_CtaCteProveedor[]
  Movimiento_CuentaCorrienteProveedor Movimiento_CuentaCorrienteProveedor[]
  CondicionIva                        CondicionIva                          @relation(fields: [CondicionIvaId], references: [Id], onUpdate: NoAction)
  Localidad                           Localidad                             @relation(fields: [LocalidadId], references: [Id], onUpdate: NoAction)
  Tenant                              Tenant                                @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([CondicionIvaId])
  @@index([LocalidadId])
}

/// Puestos de trabajo del comercio (caja, mostrador, etc.).
model PuestoTrabajo {
  Id                  BigInt                @id @default(autoincrement())
  Codigo              Int
  Descripcion         String?               @db.VarChar(8000)
  EstaEliminado       Boolean
  /// Tenant dueño de este puesto
  TenantId            BigInt
  Comprobante_Factura Comprobante_Factura[]
  Tenant              Tenant                @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Rubros o categorías de artículos.
model Rubro {
  Id            BigInt     @id @default(autoincrement())
  Descripcion   String     @db.VarChar(250)
  EstaEliminado Boolean
  /// Tenant dueño de este rubro
  TenantId      BigInt
  Articulo      Articulo[]
  Tenant        Tenant     @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Stock de artículos por depósito.
model Stock {
  Id            BigInt   @id @default(autoincrement())
  ArticuloId    BigInt
  Cantidad      Decimal  @db.Decimal(18, 3)
  EstaEliminado Boolean
  /// Tenant dueño de este stock
  TenantId      BigInt
  Articulo      Articulo @relation(fields: [ArticuloId], references: [Id], onUpdate: NoAction)
  Tenant        Tenant   @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([ArticuloId])
}

/// Tarjetas de crédito/débito configuradas para el comercio.
model Tarjeta {
  Id                BigInt              @id @default(autoincrement())
  Descripcion       String              @db.VarChar(250)
  EstaEliminado     Boolean
  /// Tenant dueño de esta tarjeta
  TenantId          BigInt
  FormaPago_Tarjeta FormaPago_Tarjeta[]
  Tenant            Tenant              @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Unidades de medida para artículos (kg, unidad, litro, etc.).
model UnidadMedida {
  Id            BigInt     @id @default(autoincrement())
  Descripcion   String     @db.VarChar(250)
  EstaEliminado Boolean
  /// Tenant dueño de esta unidad
  TenantId      BigInt
  Articulo      Articulo[]
  Tenant        Tenant     @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
}

/// Usuarios del sistema (login), asociados a Persona_Empleado.
///
/// IMPORTANTE (Supabase):
/// - AuthUserId guarda el `auth.users.id` (UUID) de Supabase.
model Usuario {
  Id                                   BigInt           @id @default(autoincrement())
  EmpleadoId                           BigInt
  Nombre                               String           @db.VarChar(50)
  EstaBloqueado                        Boolean
  EstaEliminado                        Boolean
  /// Tenant dueño de este usuario
  TenantId                             BigInt
  /// ID del usuario en Supabase Auth (auth.users.id)
  AuthUserId                           String           @unique @db.VarChar(255)
  Caja_Caja_UsuarioAperturaIdToUsuario Caja[]           @relation("Caja_UsuarioAperturaIdToUsuario")
  Caja_Caja_UsuarioCierreIdToUsuario   Caja[]           @relation("Caja_UsuarioCierreIdToUsuario")
  Comprobante                          Comprobante[]
  Movimiento                           Movimiento[]
  PerfilUsuario                        PerfilUsuario[]
  Persona_Empleado                     Persona_Empleado @relation(fields: [EmpleadoId], references: [Id], onUpdate: NoAction)
  Tenant                               Tenant           @relation(fields: [TenantId], references: [Id])

  @@index([TenantId])
  @@index([EmpleadoId])
}

/// Movimientos de caja asociados a comprobantes y usuarios.
model Movimiento {
  Id                                  BigInt                               @id @default(autoincrement())
  CajaId                              BigInt
  ComprobanteId                       BigInt
  UsuarioId                           BigInt
  Monto                               Decimal                              @db.Decimal(18, 2)
  Fecha                               DateTime
  Descripcion                         String                               @db.VarChar(4000)
  TipoMovimiento                      Int
  EstaEliminado                       Boolean
  /// Tenant dueño de este movimiento
  TenantId                            BigInt
  Caja                                Caja                                 @relation(fields: [CajaId], references: [Id], onUpdate: NoAction)
  Comprobante                         Comprobante                          @relation(fields: [ComprobanteId], references: [Id], onUpdate: NoAction)
  Tenant                              Tenant                               @relation(fields: [TenantId], references: [Id])
  Usuario                             Usuario                              @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction)
  Movimiento_CuentaCorriente          Movimiento_CuentaCorriente?
  Movimiento_CuentaCorrienteProveedor Movimiento_CuentaCorrienteProveedor?

  @@index([TenantId])
  @@index([CajaId])
  @@index([ComprobanteId])
  @@index([UsuarioId])
}

/// Movimiento de cuenta corriente de cliente.
model Movimiento_CuentaCorriente {
  Id                          BigInt                        @id
  /// Hereda TenantId desde Movimiento (Id es PK y FK)
  ClienteId                   BigInt
  Comprobante_CuentaCorriente Comprobante_CuentaCorriente[]
  Persona_Cliente             Persona_Cliente               @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  Movimiento                  Movimiento                    @relation(fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([ClienteId])
  @@index([Id])
}

/// Movimiento de cuenta corriente de proveedor.
model Movimiento_CuentaCorrienteProveedor {
  Id          BigInt     @id
  /// Hereda TenantId desde Movimiento (Id es PK y FK)
  ProveedorId BigInt
  Movimiento  Movimiento @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  Proveedor   Proveedor  @relation(fields: [ProveedorId], references: [Id], onUpdate: NoAction)

  @@index([Id])
  @@index([ProveedorId])
}

