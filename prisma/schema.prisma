  FormaPago FormaPago @relation(fields: [Id], references: [Id], onUpdate: NoAction, map: "FK_dbo.FormaPago_Cheque_dbo.FormaPago_Id")

  @@index([ChequeId], map: "IX_ChequeId")
  @@index([Id], map: "IX_Id")
}

