  Comprobante_CuentaCorriente Comprobante_CuentaCorriente[]
  Persona_Cliente             Persona_Cliente               @relation(fields: [ClienteId], references: [Id], onUpdate: NoAction)
  Movimiento                  Movimiento                    @relation(fields: [Id], references: [Id], onUpdate: NoAction)

  @@index([ClienteId])
  @@index([Id])
}

/// Movimiento de cuenta corriente de proveedor.
model Movimiento_CuentaCorrienteProveedor {
  Id          BigInt     @id
  /// Hereda TenantId desde Movimiento (Id es PK y FK)
  ProveedorId BigInt
  Movimiento  Movimiento @relation(fields: [Id], references: [Id], onUpdate: NoAction)
  Proveedor   Proveedor  @relation(fields: [ProveedorId], references: [Id], onUpdate: NoAction)

  @@index([Id])
  @@index([ProveedorId])
}

/// AuditorÃ­a de acciones realizadas sobre empleados/usuarios.
/// Registra opcionalmente la sucursal donde se realizÃ³ la acciÃ³n.
model AuditoriaEmpleado {
  Id                BigInt            @id @default(autoincrement())
  TenantId          BigInt
  Fecha             DateTime          @default(now())
  UsuarioId         BigInt
  Accion            String            @db.VarChar(100)
  EmpleadoId        BigInt?
  UsuarioAfectadoId BigInt?
  Detalle           String?           @db.VarChar(1000)
  ValorAnterior     String?           @db.VarChar(2000)
  ValorNuevo        String?           @db.VarChar(2000)
  IpAddress         String?           @db.VarChar(50)
  UserAgent         String?           @db.VarChar(500)
  Severidad         String            @default("INFO") @db.VarChar(20)
  /// Sucursal donde se realizÃ³ la acciÃ³n (opcional, para auditorÃ­as globales es null)
  SucursalId        BigInt?
  Empleado          Persona_Empleado? @relation(fields: [EmpleadoId], references: [Id], onUpdate: NoAction)
  Tenant            Tenant            @relation(fields: [TenantId], references: [Id])
  Sucursal          Sucursal?         @relation(fields: [SucursalId], references: [Id])
  UsuarioAfectado   Usuario?          @relation("Auditoria_UsuarioAfectado", fields: [UsuarioAfectadoId], references: [Id], onUpdate: NoAction)
  Usuario           Usuario           @relation("Auditoria_Usuario", fields: [UsuarioId], references: [Id], onUpdate: NoAction)

  @@index([TenantId])
  @@index([TenantId, SucursalId])
  @@index([SucursalId])
  @@index([Fecha])
  @@index([UsuarioId])
  @@index([EmpleadoId])
  @@index([Accion])
  @@index([Severidad])
}

model SesionActiva {
  Id                   BigInt   @id @default(autoincrement())
  TenantId             BigInt
  UsuarioId            BigInt
  TokenHash            String   @db.VarChar(255)
  IpAddress            String?  @db.VarChar(50)
  UserAgent            String?  @db.VarChar(500)
  Dispositivo          String?  @db.VarChar(100)
  Ubicacion            String?  @db.VarChar(200)
  FechaInicio          DateTime @default(now())
  FechaUltimaActividad DateTime @default(now())
  EstaActiva           Boolean  @default(true)
  EsConfiable          Boolean  @default(false)
  Tenant               Tenant   @relation(fields: [TenantId], references: [Id])
  Usuario              Usuario  @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction)

  @@index([TenantId])
  @@index([UsuarioId])
  @@index([TokenHash])
  @@index([EstaActiva])
  @@index([FechaUltimaActividad])
}

model DispositivoConfiable {
  Id                BigInt   @id @default(autoincrement())
  TenantId          BigInt
  UsuarioId         BigInt
  NombreDispositivo String   @db.VarChar(100)
  UserAgent         String?  @db.VarChar(500)
  IpAddress         String?  @db.VarChar(50)
  FechaRegistro     DateTime @default(now())
  FechaUltimoUso    DateTime @default(now())
  EstaActivo        Boolean  @default(true)
  Tenant            Tenant   @relation(fields: [TenantId], references: [Id])
