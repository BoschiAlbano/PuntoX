  IpAddress    String?  @db.VarChar(50)
  UserAgent    String?  @db.VarChar(500)
  Exitoso      Boolean  @default(false)
  MotivoFallo  String?  @db.VarChar(200)
  FechaIntento DateTime @default(now())
  UsuarioId    BigInt?
  Tenant       Tenant   @relation(fields: [TenantId], references: [Id])
  Usuario      Usuario? @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction)

  @@index([TenantId])
  @@index([Email])
  @@index([IpAddress])
  @@index([FechaIntento])
  @@index([Exitoso])
}

model IpBloqueada {
  Id               BigInt    @id @default(autoincrement())
  TenantId         BigInt
  IpAddress        String    @db.VarChar(50)
  Motivo           String?   @db.VarChar(200)
  FechaBloqueo     DateTime  @default(now())
  FechaDesbloqueo  DateTime?
  EstaActiva       Boolean   @default(true)
  IntentosFallidos Int       @default(0)
  Tenant           Tenant    @relation(fields: [TenantId], references: [Id])

  @@unique([TenantId, IpAddress])
  @@index([TenantId])
  @@index([IpAddress])
  @@index([EstaActiva])
  @@index([FechaBloqueo])
}

/// Tokens CSRF para protecciÃ³n contra ataques CSRF
model TokenCsrf {
  Id              BigInt   @id @default(autoincrement())
  TenantId        BigInt
  UsuarioId       BigInt?
  Token           String   @unique @db.VarChar(255)
  FechaCreacion   DateTime @default(now())
  FechaExpiracion DateTime
  Usado           Boolean  @default(false)
  IpAddress       String?  @db.VarChar(50)
  UserAgent       String?  @db.VarChar(500)
  Tenant          Tenant   @relation(fields: [TenantId], references: [Id])
  Usuario         Usuario? @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction)

  @@index([TenantId])
  @@index([Token])
  @@index([FechaExpiracion])
  @@index([UsuarioId])
}

/// CÃ³digos 2FA (TOTP) para autenticaciÃ³n de dos factores
model Codigo2FA {
  Id              BigInt    @id @default(autoincrement())
  TenantId        BigInt
  UsuarioId       BigInt
  Secret          String    @db.VarChar(255)
  EstaActivo      Boolean   @default(false)
  FechaActivacion DateTime?
  BackupCodes     String?   @db.VarChar(2000)
  Tenant          Tenant    @relation(fields: [TenantId], references: [Id])
  Usuario         Usuario   @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction)

  @@unique([TenantId, UsuarioId])
  @@index([TenantId])
  @@index([UsuarioId])
  @@index([EstaActivo])
}

/// Alertas de seguridad para eventos sospechosos
model AlertaSeguridad {
  Id              BigInt    @id @default(autoincrement())
  TenantId        BigInt
  UsuarioId       BigInt?
  Tipo            String    @db.VarChar(50)
  Severidad       String    @default("MEDIA") @db.VarChar(20)
  Mensaje         String    @db.VarChar(500)
  Detalles        String?   @db.VarChar(2000)
  IpAddress       String?   @db.VarChar(50)
  UserAgent       String?   @db.VarChar(500)
  FechaCreacion   DateTime  @default(now())
  EstaResuelta    Boolean   @default(false)
  FechaResolucion DateTime?
  ResueltoPor     BigInt?
  UsuarioResuelto Usuario?  @relation("Alerta_ResueltoPor", fields: [ResueltoPor], references: [Id], onUpdate: NoAction)
  Tenant          Tenant    @relation(fields: [TenantId], references: [Id])
  Usuario         Usuario?  @relation(fields: [UsuarioId], references: [Id], onUpdate: NoAction)

  @@index([TenantId])
  @@index([UsuarioId])
  @@index([Tipo])
  @@index([Severidad])
  @@index([FechaCreacion])
  @@index([EstaResuelta])
}

enum PerfilTipo {
  ADMINISTRADOR
  EMPLEADO
  SUPERADMIN
}

enum TiposVenta {
  UNIDAD
  PESO
}

/// Sistema de Notificaciones
model Notificacion {
  Id        BigInt   @id @default(autoincrement())
  TenantId  BigInt
  UsuarioId BigInt?
  Tipo      String   @db.VarChar(50) // INFO, WARNING, ERROR, SUCCESS
  Titulo    String   @db.VarChar(200)
  Mensaje   String   @db.VarChar(500)
  Leida     Boolean  @default(false)
  AccionUrl String?  @db.VarChar(500)
  Fecha     DateTime @default(now())

  // Para evitar repeticiones (ej. STOCK_BAJO, ARTICULO, 123)
  EntidadTipo String? @db.VarChar(100)
  EntidadId   String? @db.VarChar(100)

  Tenant  Tenant   @relation(fields: [TenantId], references: [Id])
  Usuario Usuario? @relation(fields: [UsuarioId], references: [Id])

  @@index([TenantId, UsuarioId, Leida])
  @@index([EntidadTipo, EntidadId, Leida])
}
