  Tarjeta        Tarjeta   @relation(fields: [TarjetaId], references: [Id], onUpdate: NoAction, map: "FK_dbo.FormaPago_Tarjeta_dbo.Tarjeta_TarjetaId")

  @@index([Id], map: "IX_Id")
  @@index([TarjetaId], map: "IX_TarjetaId")
}

/// Relación muchos a muchos entre formularios y perfiles (permisos por pantalla).
